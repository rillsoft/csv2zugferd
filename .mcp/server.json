{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "de.zugferd-tools/csv2zugferd",
  "title": "csv2zugferd",
  "description": "csv2zugferd setup assistant: drafts and checks the CSV to ZUGFeRD/Factur-X mapping, local via stdio",
  "websiteUrl": "https://zugferd-tools.de/docs/mcp-server/",
  "repository": {
    "url": "https://github.com/rillsoft/csv2zugferd",
    "source": "github"
  },
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "csv2zugferd",
      "version": "1.3.1",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": []
    }
  ]
}
